            { "id": "a1000001-0000-4000-8000-00000000000d", "name": "imagem", "value": "={{ $json.body.deal.image_url || '' }}", "type": "string" },
            { "id": "a1000001-0000-4000-8000-00000000000e", "name": "painel", "value": "={{ $json.body.panel_url }}", "type": "string" },
            { "id": "a1000001-0000-4000-8000-00000000000f", "name": "mensagem", "value": "={{ '🔥 ' + $json.body.deal.title + '\\n\\n' + ($json.body.deal.price_original != null ? '📌 De: ' + Number($json.body.deal.price_original).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) + '\\n' : '') + '👉 Por apenas: ' + Number($json.body.deal.price_promo).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) + ($json.body.deal.payment_note ? ' (' + $json.body.deal.payment_note + ')' : '') + ($json.body.deal.coupon_code ? '\\n🎫 Cupom: ' + $json.body.deal.coupon_code : '') + ($json.body.deal.highlight ? '\\n⚡ ' + $json.body.deal.highlight : '') + ($json.body.deal.shipping === 'free' ? '\\n📦 Frete grátis' : '') }}", "type": "string" },
            { "id": "a1000001-0000-4000-8000-000000000011", "name": "mensagem_com_link", "value": "={{ '🔥 ' + $json.body.deal.title + '\\n\\n' + ($json.body.deal.price_original != null ? '📌 De: ' + Number($json.body.deal.price_original).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) + '\\n' : '') + '👉 Por apenas: ' + Number($json.body.deal.price_promo).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) + ($json.body.deal.payment_note ? ' (' + $json.body.deal.payment_note + ')' : '') + ($json.body.deal.coupon_code ? '\\n🎫 Cupom: ' + $json.body.deal.coupon_code : '') + ($json.body.deal.highlight ? '\\n⚡ ' + $json.body.deal.highlight : '') + ($json.body.deal.shipping === 'free' ? '\\n📦 Frete grátis' : '') + '\\n\\n🛒 ' + ($json.body.tracking_url || $json.body.deal.affiliate_url) }}", "type": "string" }
          ]
        },
        "options": {}
