{
  "name": "GDP — Promoção para o Telegram",
  "nodes": [
    {
      "parameters": {
        "content": "## GDP — Promoção para o Telegram\nO Supabase chama este webhook quando uma promoção é cadastrada (`deal.created`) ou vira Pronta (`deal.ready`). Só promoções com status **ready** são publicadas; rascunhos e testes param no nó **Está pronta?**.\n\n1. **Supabase: promoção cadastrada** → credencial **Header Auth** (`X-GDP-Secret`).\n2. **Telegram: com foto** e **Telegram: só texto** → credencial **Telegram API** com o token do bot.\n3. Em **Dados da promoção**, troque o campo `canal` pelo `@usuario` do canal (ou o ID `-100…` se for privado).\n4. O bot precisa ser **administrador do canal** com permissão de publicar.\n5. Só um workflow pode estar ativo com o caminho `gdp-deal-created`.",
        "height": 380,
        "width": 520
      },
      "id": "0f3a6c2e-51d4-4b7a-9c1e-2a8b7d4e6f10",
      "name": "Como usar",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-80, -440]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "gdp-deal-created",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "5b1f9c1e-6a2b-4c3d-9e8f-0a1b2c3d4e01",
      "name": "Supabase: promoção cadastrada",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "7d2e4f6a-8b9c-4d1e-a2f3-b4c5d6e7f801"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a1000001-0000-4000-8000-000000000010", "name": "canal", "value": "@SEU_CANAL", "type": "string" },
            { "id": "a1000001-0000-4000-8000-000000000001", "name": "evento", "value": "={{ $json.body.event }}", "type": "string" },
            { "id": "a1000001-0000-4000-8000-000000000002", "name": "id", "value": "={{ $json.body.deal.id }}", "type": "string" },
            { "id": "a1000001-0000-4000-8000-000000000003", "name": "codigo", "value": "={{ $json.body.deal.public_code }}", "type": "string" },
            { "id": "a1000001-0000-4000-8000-000000000004", "name": "titulo", "value": "={{ $json.body.deal.title }}", "type": "string" },
            { "id": "a1000001-0000-4000-8000-000000000005", "name": "status", "value": "={{ $json.body.deal.status || '' }}", "type": "string" },
            { "id": "a1000001-0000-4000-8000-000000000006", "name": "loja", "value": "={{ $json.body.store ? $json.body.store.name : '' }}", "type": "string" },
            { "id": "a1000001-0000-4000-8000-000000000007", "name": "preco_promo", "value": "={{ $json.body.deal.price_promo }}", "type": "number" },
            { "id": "a1000001-0000-4000-8000-000000000008", "name": "preco_de", "value": "={{ $json.body.deal.price_original != null ? Number($json.body.deal.price_original).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) : '' }}", "type": "string" },
            { "id": "a1000001-0000-4000-8000-000000000009", "name": "preco_por", "value": "={{ Number($json.body.deal.price_promo).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) }}", "type": "string" },
            { "id": "a1000001-0000-4000-8000-00000000000a", "name": "desconto", "value": "={{ $json.body.deal.discount_pct != null ? $json.body.deal.discount_pct + '% OFF' : '' }}", "type": "string" },
            { "id": "a1000001-0000-4000-8000-00000000000b", "name": "cupom", "value": "={{ $json.body.deal.coupon_code || '' }}", "type": "string" },
            { "id": "a1000001-0000-4000-8000-00000000000c", "name": "link_afiliado", "value": "={{ $json.body.deal.affiliate_url }}", "type": "string" },
            { "id": "a1000001-0000-4000-8000-00000000000d", "name": "imagem", "value": "={{ $json.body.deal.image_url || '' }}", "type": "string" },
            { "id": "a1000001-0000-4000-8000-00000000000e", "name": "painel", "value": "={{ $json.body.panel_url }}", "type": "string" },
            { "id": "a1000001-0000-4000-8000-00000000000f", "name": "mensagem", "value": "={{ '🔥 ' + $json.body.deal.title + '\\n\\n' + ($json.body.deal.price_original != null ? '📌 De: ' + Number($json.body.deal.price_original).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) + '\\n' : '') + '👉 Por apenas: ' + Number($json.body.deal.price_promo).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) + ($json.body.deal.payment_note ? ' (' + $json.body.deal.payment_note + ')' : '') + ($json.body.deal.coupon_code ? '\\n🎫 Cupom: ' + $json.body.deal.coupon_code : '') + ($json.body.deal.highlight ? '\\n⚡ ' + $json.body.deal.highlight : '') + ($json.body.deal.shipping === 'free' ? '\\n📦 Frete grátis' : '') }}", "type": "string" },
            { "id": "a1000001-0000-4000-8000-000000000011", "name": "mensagem_com_link", "value": "={{ '🔥 ' + $json.body.deal.title + '\\n\\n' + ($json.body.deal.price_original != null ? '📌 De: ' + Number($json.body.deal.price_original).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) + '\\n' : '') + '👉 Por apenas: ' + Number($json.body.deal.price_promo).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) + ($json.body.deal.payment_note ? ' (' + $json.body.deal.payment_note + ')' : '') + ($json.body.deal.coupon_code ? '\\n🎫 Cupom: ' + $json.body.deal.coupon_code : '') + ($json.body.deal.highlight ? '\\n⚡ ' + $json.body.deal.highlight : '') + ($json.body.deal.shipping === 'free' ? '\\n📦 Frete grátis' : '') + '\\n\\n🛒 ' + $json.body.deal.affiliate_url }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "9c4d2b7a-3e1f-4a6b-8d5c-7e2f1a0b9c20",
      "name": "Dados da promoção",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [260, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "b2000001-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.status }}",
              "rightValue": "ready",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "3e8a1c5d-7b2f-4d9e-a1c3-5f7b9d2e4a31",
      "name": "Está pronta?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [520, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "b2000001-0000-4000-8000-000000000002",
              "leftValue": "={{ $json.imagem }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "6a2d4f8b-1c3e-4a5b-9d7f-2b4c6e8a0d42",
      "name": "Tem foto?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [780, -100]
    },
    {
      "parameters": {
        "operation": "sendPhoto",
        "chatId": "={{ $json.canal }}",
        "file": "={{ $json.imagem }}",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  { "text": "🛒 PEGAR PROMOÇÃO", "additionalFields": { "url": "={{ $json.link_afiliado }}" } }
                ]
              }
            }
          ]
        },
        "additionalFields": { "caption": "={{ $json.mensagem }}" }
      },
      "id": "8b4f6a2c-3d5e-4f7a-8c9b-1d3e5f7a9b53",
      "name": "Telegram: com foto",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1040, -200]
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $json.canal }}",
        "text": "={{ $json.mensagem }}",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
